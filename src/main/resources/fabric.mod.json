{
  "schemaVersion": 1,
  "id": "pandorical-geyser",
  "version": "${version}",
  "name": "Pandorical Geyser",
  "description": "Lets Bedrock players, through Geyser and Floodgate, join a Pandorical server and see its modded blocks and items",
  "authors": [
    "justfatlard"
  ],
  "contact": {
    "sources": "https://github.com/fatlard1993/pandorical-geyser"
  },
  "license": "MIT",
  "icon": "assets/pandorical-geyser/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "justfatlard.pandorical_geyser.Main"
    ]
  },
  "mixins": [
    "pandorical-geyser.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "fabric-api": "${fabricApiVersion}",
    "minecraft": "${minecraftDependency}",
    "java": ">=25",
    "pandorical": ">=15.22.0",
    "geyser-fabric": ">=2.12.0-"
  },
  "suggests": {
    "floodgate": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://github.com/sponsors/fatlard1993"
      }
    }
  }
}
